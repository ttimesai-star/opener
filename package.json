{
  "name": "opener",
  "version": "0.1.0",
  "private": true,
  "description": "Opener: a Qloo-powered agent that briefs promoters on who should open for a headliner in a given city.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["web"],
  "scripts": {
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "npm --workspace web run dev",
    "start": "node server/src/index.ts",
    "brief": "node server/src/cli.ts",
    "build": "npm --workspace web run build",
    "typecheck": "tsc -p server/tsconfig.json && npm --workspace web run typecheck",
    "test": "node --test \"server/test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
