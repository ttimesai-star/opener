# Copy to .env (never commit it). Everything is optional: with nothing set,
# Opener runs on synthetic mock data with the scripted planner.

# Qloo hackathon key -> live mode through `qloo mcp` (@qloo/qloo-harness).
QLOO_API_KEY=
# Force mock even if a key is present: QLOO_MODE=mock
# On Windows the harness binary is qloo.cmd:
# QLOO_BIN=qloo.cmd

# LLM agent (any OpenAI-compatible endpoint). Default primary: Gemini free tier.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3-flash-preview
# Optional fallback provider, e.g. Groq or Mistral:
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Server
# PORT=8787
# ALLOWED_ORIGIN=https://opener.pages.dev   # only if the web app is hosted separately
